<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Jukebox</string>
  <key>CFBundleDisplayName</key><string>Party Jukebox</string>
  <key>CFBundleIdentifier</key><string>local.partyjukebox.launcher</string>
  <key>CFBundleExecutable</key><string>Jukebox</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
