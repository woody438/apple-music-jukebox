#!/bin/bash
# Party Jukebox launcher. Double-click to start, double-click again to stop.
#
# The menu bar icon drives it too, with an explicit verb so a click can never
# toggle the wrong way:
#   (none)  toggle -- what the Dock does
#   start   start, or if already running just open the page
#   stop    stop, or nothing if already stopped
#   menu    only make sure the menu bar icon is up
# It goes through here, launched by LaunchServices, rather than the menu bar
# starting node itself: that keeps this app as the server's parent, and so as
# the app macOS has already been told may control Music.
#
# Deliberately has no confirmation dialog. Stopping the jukebox does NOT stop
# Music -- the room keeps playing whatever is on -- and restarting restores
# the queue from data/state.json, so an accidental stop costs one more click.
# A dialog would need its own automation permission and could fail silently,
# which is worse at a party than a cheap mistake.

set -u

# This app lives at the root of the repo it runs.
HERE="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$HERE/../../.." && pwd)"
PORT="${PORT:-8484}"
LOG="$REPO/data/jukebox.log"
AWAKE_LIMIT_SECONDS="${AWAKE_LIMIT_SECONDS:-43200}"   # 12 hours
STARTING="$REPO/data/launcher-starting.pid"
MENU_JS="$REPO/menubar/menubar.js"
# How the icon's process is found. Matches its whole launch line, not just
# the file name: a bare "menubar/menubar.js" would also match an editor that
# has the file open -- and Update.command pkills whatever this matches.
# Keep in step with the same line in Update.command.
MENU_PATTERN='osascript -l JavaScript .*menubar/menubar[.]js'

# Anything unrecognised -- including the -psn_ argument old macOS versions
# passed to apps launched from Finder -- is the Dock's toggle.
VERB="${1:-toggle}"
case "$VERB" in start|stop|menu|toggle) ;; *) VERB=toggle ;; esac

# Per-machine settings, if there are any. An app launched from the Dock has no
# shell, so this is the only way to give it PUBLIC_URL -- which a Mac with two
# network adapters needs, because the address guessed from the routing table
# may not be the network the phones are on.
[ -f "$REPO/jukebox.conf" ] && . "$REPO/jukebox.conf"

note() { osascript -e "display notification \"$1\" with title \"Party Jukebox\"" >/dev/null 2>&1; }

fail() {
  note "$1"
  osascript -e "display dialog \"$1\" buttons {\"OK\"} default button \"OK\" with icon stop with title \"Party Jukebox\"" >/dev/null 2>&1
  exit 1
}

# A GUI-launched app gets a bare PATH, so Homebrew's node is not on it.
NODE=""
for candidate in /opt/homebrew/bin/node /usr/local/bin/node /usr/bin/node; do
  [ -x "$candidate" ] && NODE="$candidate" && break
done
[ -z "$NODE" ] && NODE="$(command -v node 2>/dev/null || true)"
[ -z "$NODE" ] && fail "Node.js was not found. Open Terminal and run: brew install node"

# The menu bar icon: a separate background process, so if it ever fails to
# come up the jukebox is exactly what it was without it. Never waited on.
# JUKEBOX_MENU_BAR=0 in jukebox.conf turns it off.
start_menu_bar() {
  [ "${JUKEBOX_MENU_BAR:-1}" = "0" ] && return 0
  [ -f "$MENU_JS" ] || return 0
  /usr/bin/pgrep -f "$MENU_PATTERN" >/dev/null 2>&1 && return 0
  mkdir -p "$REPO/data"
  # Emptied here, then opened for APPEND: the helper appends to the same file,
  # and a plain > would have this process write over its lines.
  : > "$REPO/data/menubar.log"
  nohup /usr/bin/osascript -l JavaScript "$MENU_JS" "$REPO" "$NODE" "$PORT" "${PUBLIC_URL:-}" \
    >>"$REPO/data/menubar.log" 2>&1 &
}

start_menu_bar

[ "$VERB" = "menu" ] && exit 0

# Ask the port, not a pid file: this also finds a server started from Terminal.
listening_pid() { /usr/sbin/lsof -ti "tcp:$PORT" -sTCP:LISTEN 2>/dev/null | head -1; }

PID="$(listening_pid)"

if [ -n "$PID" ] && [ "$VERB" = "start" ]; then
  # Already up: the host wanted the page, so give them the page.
  open "http://localhost:$PORT/"
  exit 0
fi

if [ -z "$PID" ] && [ "$VERB" = "stop" ]; then
  note "Already stopped."
  exit 0
fi

if [ -n "$PID" ]; then
  # ---- running: stop it ----
  kill "$PID" 2>/dev/null
  for _ in $(seq 1 20); do
    sleep 0.25
    [ -z "$(listening_pid)" ] && break
  done
  if [ -n "$(listening_pid)" ]; then
    kill -9 "$(listening_pid)" 2>/dev/null
    sleep 0.5
  fi
  note "Stopped. Music carries on playing."
  exit 0
fi

# ---- not running: start it ----
mkdir -p "$REPO/data"

# Tells the menu bar we are on our way up, for as long as this script lives
# -- indexing takes a moment, and "stopped" in the meantime would be a lie.
echo $$ > "$STARTING"
trap 'rm -f "$STARTING"' EXIT

open -ga Music 2>/dev/null || true

cd "$REPO" || fail "Could not find the jukebox folder."
: > "$LOG"
PORT="$PORT" PUBLIC_URL="${PUBLIC_URL:-}" JUKEBOX_TITLE="${JUKEBOX_TITLE:-}" JUKEBOX_PLAYLIST="${JUKEBOX_PLAYLIST:-}" JUKEBOX_MAX_PER_PHONE="${JUKEBOX_MAX_PER_PHONE:-}" JUKEBOX_MAX_PER_LAPTOP="${JUKEBOX_MAX_PER_LAPTOP:-}" JUKEBOX_MAX_QUEUE="${JUKEBOX_MAX_QUEUE:-}" JUKEBOX_REPEAT_MINUTES="${JUKEBOX_REPEAT_MINUTES:-}" JUKEBOX_WIFI_NAME="${JUKEBOX_WIFI_NAME:-}" JUKEBOX_WIFI_PASSWORD="${JUKEBOX_WIFI_PASSWORD:-}" nohup "$NODE" server.js >>"$LOG" 2>&1 &
SERVER_PID=$!

# No sleep and no display sleep while the server lives -- but capped, because
# this app leaves nothing on screen to remind you it is running. Without the
# cap, a jukebox forgotten after the party keeps the Mac awake all night and
# flattens the battery. Twelve hours outlasts any party and still gives up by
# morning.
nohup caffeinate -dimsu -t "$AWAKE_LIMIT_SECONDS" -w "$SERVER_PID" >/dev/null 2>&1 &

for _ in $(seq 1 90); do
  if /usr/bin/curl -fsS "http://127.0.0.1:$PORT/api/config" >/dev/null 2>&1; then
    open "http://localhost:$PORT/"
    note "Running. Double-click again to stop it."
    exit 0
  fi
  if ! kill -0 "$SERVER_PID" 2>/dev/null; then
    fail "The jukebox stopped while starting. See data/jukebox.log"
  fi
  sleep 1
done

fail "The jukebox did not come up in 90 seconds. See data/jukebox.log"
