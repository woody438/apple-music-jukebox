# Copy to jukebox.conf for per-machine settings. Not tracked by git.
#   cp jukebox.conf.example jukebox.conf
#
# The Dock app reads this. It has no shell, so environment variables you set
# in Terminal never reach it -- this file is the way in.

# A Mac with two network adapters may advertise the wrong one. The easy fix
# is the menu bar icon: Guest Network -> pick the adapter. That choice wins
# over this line and follows the adapter if its address changes.
# To pin an exact address instead, check which one the phones can reach:
#   for i in en0 en1 en2 en3 en4; do ip=$(ipconfig getifaddr $i 2>/dev/null) && echo "$i = $ip"; done
# PUBLIC_URL="http://192.168.1.40:8484/"

# The menu bar icon (the note at the top of the screen). 0 turns it off.
# JUKEBOX_MENU_BAR=1

# The neon marquee text.
# JUKEBOX_TITLE="JUKEBOX"

# The playlist the queue mirrors into.
# JUKEBOX_PLAYLIST="Jukebox"

# --- Guest rules -----------------------------------------------------------
# How many songs one phone may have WAITING at once. A song that has started
# playing has left the queue and freed its slot.
# JUKEBOX_MAX_PER_PHONE=25

# The same, for the laptop. The laptop only counts as the laptop when the
# browser is at http://localhost:8484/ -- open it by its LAN address and the
# server sees an ordinary guest and applies the phone limit.
# JUKEBOX_MAX_PER_LAPTOP=25

# Total songs that may be queued by everyone.
# JUKEBOX_MAX_QUEUE=60

# Minutes before the same song may be picked again. 0 turns the rule off.
# The laptop is always exempt from it.
# JUKEBOX_REPEAT_MINUTES=60
